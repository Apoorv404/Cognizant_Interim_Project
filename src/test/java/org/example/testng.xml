<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Amazon Mini Project Suite" parallel="tests" thread-count="2">

    <test name="Amazon Search Test - Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="org.example.tests.AmazonSearchTest"/>
        </classes>
    </test>

    <test name="Amazon Search Test - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="org.example.tests.AmazonSearchTest"/>
        </classes>
    </test>

</suite>